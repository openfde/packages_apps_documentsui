<!--
  Content view of DeleteFilesConfirmationActivity (删除前逐项确认弹窗).
  供删除类 AppFunction 在 requireConfirmation=true 时展示待删除文件列表；
  每行是带复选框的文件路径（默认全选），用户可取消勾选想保留的文件。
  与 EmptyTrashActivity 的对话框保持一致：
    - 透明窗口 + 自带圆角背景（empty_trash_dialog_background）；
    - @android:id/button1 / button2 保持与既有对话框按钮约定一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/delete_file_dialog"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:orientation="vertical"
    android:background="@drawable/empty_trash_dialog_background"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/delete_file_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.AppCompat.Title"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:id="@+id/delete_file_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/delete_files_confirm_message"
        android:textAppearance="@style/TextAppearance.AppCompat.Body1"
        android:textColor="?android:attr/textColorSecondary" />

    <ListView
        android:id="@+id/delete_file_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:scrollbars="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@android:id/button2"
            style="@style/DialogTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <Button
            android:id="@android:id/button1"
            style="@style/DialogTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/delete_files_confirm_action" />
    </LinearLayout>
</LinearLayout>
