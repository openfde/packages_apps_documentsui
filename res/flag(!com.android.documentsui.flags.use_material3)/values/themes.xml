<resources>
    <!-- PickDialogTheme is defined in the M3 resource folder, and it's used specifically for M3,
     but it's referenced inside AndroidManifest.xml so without the definition for this style the
     build fails, hence an empty style definition here for M3 off (it won't be used for M3 off)
     just for the sake of compilation.
     Note: adding this in the common XML file will cause duplicate definition when M3 is ON, and
     since it's used in the AndroidManifest.xml file, the common getRes() trick won't work there.
     -->
    <style name="PickDialogTheme" />
</resources>
