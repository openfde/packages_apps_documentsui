<!--
  Material3 variant of the EmptyTrashActivity content view, used when the use_material3 flag is
  enabled. It follows the Material3 alert dialog spec:
   * colorSurfaceContainerHigh surface with the extra-large corner radius (drawn by
     empty_trash_dialog_background_m3, since the activity window is transparent);
   * HeadlineSmall title on colorOnSurface;
   * BodyMedium message on colorOnSurfaceVariant;
   * right-aligned text buttons with M3 typography.
  The ids @android:id/button1 / @android:id/button2 are kept so existing dialog-button UI tests
  (e.g. UiBot#clickDialogOkButton) continue to work.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/empty_trash_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/empty_trash_dialog_background_m3"
    android:paddingStart="@dimen/dialog_content_padding_horizontal"
    android:paddingEnd="@dimen/dialog_content_padding_horizontal"
    android:paddingTop="@dimen/space_small_4"
    android:paddingBottom="@dimen/space_small_4">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_trash_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_trash_dialog_title"
        android:textAppearance="@style/TextAppearance.DocumentsUI.HeadlineSmall"
        android:textColor="?attr/colorOnSurface" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/empty_trash_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small_1"
        android:text="@string/empty_trash_dialog_message"
        android:textAppearance="@style/TextAppearance.DocumentsUI.BodyMedium"
        android:textColor="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_small_4"
        android:orientation="horizontal"
        android:gravity="end">

        <com.google.android.material.button.MaterialButton
            android:id="@android:id/button2"
            style="@style/DialogTextButtonM3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@android:string/cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@android:id/button1"
            style="@style/DialogTextButtonM3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_extra_small_4"
            android:text="@string/empty_trash_dialog_action_button" />
    </LinearLayout>
</LinearLayout>
