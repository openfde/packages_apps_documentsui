<resources>
    <style name="LauncherThemeM3" parent="DocumentsTheme">
        <item name="android:windowBackground">@drawable/launcher_screen_m3</item>
    </style>
    <!-- DocumentsTheme is allow customize by run time overlay -->
    <style name="DocumentsThemeM3" parent="@android:style/Theme.DeviceDefault.DocumentsUI">

        <!-- these system bar colors are required for SDK 30 -->
        <item name="android:statusBarColor">@color/app_background_color_m3</item>
        <item name="android:navigationBarColor">@color/app_background_color_m3</item>

        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSoftInputMode">stateUnspecified|adjustUnspecified</item>

        <!-- OEM should not overlay this attr -->
        <item name="android:windowNoTitle">true</item>

    </style>

    <style name="DocumentsDefaultThemeM3" parent="@style/Theme.Material3Expressive.DayNight.NoActionBar">

        <!-- This only used by support lib, not allow to overlay -->
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>

        <!-- For material design widget, chips, buttons, not support attr-->
        <item name="colorPrimary">@color/primary_m3</item>
        <item name="colorAccent">@color/primary_m3</item>

        <!-- TODO need to solve the error handle in GridItemThumbnail -->
        <item name="gridItemTint">@color/item_doc_grid_tint_m3</item>

        <item name="actionBarTheme">@style/ActionBarThemeM3</item>
        <item name="toolbarStyle">@style/ToolbarStyles</item>
        <item name="toolbarNavigationButtonStyle">@style/HamburgerMenuButtonStyle</item>
        <item name="actionOverflowButtonStyle">@style/OverflowButtonStyleM3</item>
        <item name="autoCompleteTextViewStyle">@style/AutoCompleteTextViewStyleM3</item>
        <item name="bottomSheetDialogTheme">@style/BottomSheetDialogStyleM3</item>
        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogThemeM3</item>
        <item name="queryBackground">@color/menu_search_background_m3</item>
        <item name="snackbarStyle">@style/SnackbarStyle</item>
        <item name="snackbarButtonStyle">@style/SnackbarButtonStyleM3</item>
        <item name="snackbarTextViewStyle">@style/SnackbarTextViewStyle</item>

        <!-- Menus -->
        <item name="actionOverflowMenuStyle">@style/OverflowMenuStyleM3</item>
        <item name="android:itemBackground">@drawable/menu_item_background</item>

        <!-- Menu text appearance -->
        <item name="android:itemTextAppearance">@style/MenuItemTextAppearanceM3</item>

        <!-- System bar colors. -->
        <item name="android:statusBarColor">?attr/colorSurfaceContainer</item>
        <item name="android:navigationBarColor">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Similar to Widget.Material3.SideSheet.Modal.Detached, but with a different width. Manually
     set the background and the margin size, for consistency with the coplanar side sheet which
     relies on same attributes. -->
    <style name="PeekMetadataModalSheetTheme" parent="Widget.Material3.SideSheet.Modal">
        <item name="android:layout_margin">@dimen/space_small_1</item>
        <item name="android:layout_width">
            @dimen/peek_metadata_sheet_width
        </item>
        <item name="android:backgroundTint">
            ?attr/colorSurfaceContainerHigh
        </item>
        <item name="android:background">
            @drawable/peek_metadata_sheet_background
        </item>
    </style>

    <style name="PeekMetadataSheetDialogTheme" parent="Theme.Material3.DayNight.SideSheetDialog">
        <item name="sideSheetModalStyle">@style/PeekMetadataModalSheetTheme</item>
    </style>

    <style name="PickDialogTheme" parent="DocumentsThemeM3">
        <item name="android:windowBackground">@android:color/transparent</item>
        <!-- Theme with windowIsTranslucent must be applied in AndroidManifest.xml to make the
             the window support transparency. windowIsTranslucent will impact the triggering
             activity's lifecycle, e.g. when a translucent pick dialog is displayed on top of
             another activity, the activity's state will turn into "Paused" instead of "Stopped".
             That's why we only apply this theme to the desktop PickActivity (check the usage of
             this theme in AndroidManifest.xml file).
         -->
        <item name="android:windowIsTranslucent">true</item>
        <!-- Apps like Chrome triggers a sharesheet with a semi-transparent background when picking
             files, choosing DocsUI in the sharesheet will show DocsUI's semi-transparent
             background, the hiding of sharesheet background and showing of DocsUI's background
             triggers a glitchy animation. Need backgroundDimEnabled to prevent that. Check
             b/382123223##comment4.
         -->
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">@dimen/pick_dialog_background_alpha</item>
        <item name="android:windowAnimationStyle">@style/PickDialogAnimation</item>
    </style>
</resources>
