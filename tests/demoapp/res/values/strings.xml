<resources>
    <string name="app_name">DocsUI Demo</string>
    <string name="app_title">DocumentsUI Demo</string>

    <!-- Tabs -->
    <string name="tab_general">General</string>
    <string name="tab_esp">ESP</string>
    <string name="tab_dsp">DSP</string>
    <string name="tab_mdp">MDP</string>

    <!-- Buttons -->
    <string name="btn_open_doc_generic">Open Document (Generic)</string>
    <string name="btn_create_doc">Create Document</string>
    <string name="btn_pick_esp_primary">Pick File (Primary)</string>
    <string name="btn_pick_dsp_downloads">Pick File (Downloads)</string>
    <string name="btn_pick_mdp_images">Pick File (Images)</string>
    <string name="btn_pick_mdp_audio">Pick File (Audio)</string>
    <string name="btn_pick_mdp_videos">Pick File (Videos)</string>

    <!-- Results & Status -->
    <string name="result_label">Result:</string>
    <string name="status_none">No action performed yet</string>
    <string name="status_success">Success: %1$s</string>
    <string name="status_created">Created: %1$s</string>
    <string name="status_cancelled">Cancelled</string>
    <string name="error_no_activity">No app found to handle this intent.</string>

    <!-- Notes -->
    <string name="note_generic">Opens the system picker without a specific target. Defaults to the last used location.</string>
    <string name="note_esp">Targets the External Storage Provider (com.android.externalstorage.documents). Access \'Primary\' (Internal Storage) and SD cards.</string>
    <string name="note_dsp">Targets the Download Storage Provider (com.android.providers.downloads.documents). Access the \'Downloads\' collection.</string>
    <string name="note_mdp">Targets the Media Documents Provider (com.android.providers.media.documents). Access indexed Images, Audio, and Video collections.</string>

